{
  "name": "stepwise-firestore-rules-tests",
  "private": true,
  "type": "module",
  "description": "Checks firestore.rules against the local Firestore emulator. No real project is touched.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-stepwise --config ../../firebase.json \"node --test rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0"
  }
}
